{
  "multipart": [
    {
      "apply": {
        "model": "mellifera:block/cable_core"
      }
    },
    {
      "when": {
        "north": "pipe"
      },
      "apply": {
        "model": "mellifera:block/cable_arm"
      }
    },
    {
      "when": {
        "north": "plug"
      },
      "apply": {
        "model": "mellifera:block/cable_arm_plug"
      }
    },
    {
      "when": {
        "east": "pipe"
      },
      "apply": {
        "model": "mellifera:block/cable_arm",
        "y": 90
      }
    },
    {
      "when": {
        "east": "plug"
      },
      "apply": {
        "model": "mellifera:block/cable_arm_plug",
        "y": 90
      }
    },
    {
      "when": {
        "south": "pipe"
      },
      "apply": {
        "model": "mellifera:block/cable_arm",
        "y": 180
      }
    },
    {
      "when": {
        "south": "plug"
      },
      "apply": {
        "model": "mellifera:block/cable_arm_plug",
        "y": 180
      }
    },
    {
      "when": {
        "west": "pipe"
      },
      "apply": {
        "model": "mellifera:block/cable_arm",
        "y": 270
      }
    },
    {
      "when": {
        "west": "plug"
      },
      "apply": {
        "model": "mellifera:block/cable_arm_plug",
        "y": 270
      }
    },
    {
      "when": {
        "up": "pipe"
      },
      "apply": {
        "model": "mellifera:block/cable_arm",
        "x": 270
      }
    },
    {
      "when": {
        "up": "plug"
      },
      "apply": {
        "model": "mellifera:block/cable_arm_plug",
        "x": 270
      }
    },
    {
      "when": {
        "down": "pipe"
      },
      "apply": {
        "model": "mellifera:block/cable_arm",
        "x": 90
      }
    },
    {
      "when": {
        "down": "plug"
      },
      "apply": {
        "model": "mellifera:block/cable_arm_plug",
        "x": 90
      }
    }
  ]
